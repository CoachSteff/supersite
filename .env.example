# Supersite Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# AI Provider API Keys
# ============================================
# Choose ONE provider and add its API key below

# Anthropic Claude (recommended)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT
# OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (local, no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================
# Authentication
# ============================================
# REQUIRED in all environments. Must be at least 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_here_at_least_32_chars_long_please

# Set to "true" ONLY when the app runs behind a trusted reverse proxy (Caddy, Nginx, Cloudflare).
# When true, the app reads client IP from X-Forwarded-For / X-Real-IP headers.
# When false (default), those headers are ignored and request.ip is used.
# TRUSTED_PROXY=false

# ============================================
# Configuration Notes
# ============================================
# 1. Get your API keys:
#    - Anthropic: https://console.anthropic.com/
#    - OpenAI: https://platform.openai.com/api-keys
#    - Google: https://makersuite.google.com/app/apikey
#
# 2. Set your provider in config/site.yaml
#
# 3. Never commit .env.local to version control!
